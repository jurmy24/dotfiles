#!/usr/bin/env bash
# mxpad — dispatcher for Logitech MX Creative Console buttons (Bitfocus Companion)
# Each Companion button runs:  /home/YOU/.local/bin/mxpad <action>
#
# Requires: ydotool (+ ydotoold user service), playerctl,
#           GNOME extension "Activate Window By Title" (for focus-or-launch)
set -u
export YDOTOOL_SOCKET="${YDOTOOL_SOCKET:-/run/user/$(id -u)/.ydotool_socket}"

# Linux input key codes used below:
# 28=ENTER  29=LEFTCTRL  33=F  52=DOT  99=PRINT  104=PAGEUP  109=PAGEDOWN  125=SUPER

focus() { # focus <method> <arg> — returns 0 if an existing window was activated
  local out
  out=$(gdbus call --session --dest org.gnome.Shell \
        --object-path /de/lucaswerkmeister/ActivateWindowByTitle \
        --method "de.lucaswerkmeister.ActivateWindowByTitle.$1" "$2" 2>/dev/null)
  [[ "$out" == *true* ]]
}

launch() { setsid -f "$@" >/dev/null 2>&1; }

case "${1:-}" in
  # ================= PAGE 1 — shortcuts & AI =================
  btop)        launch /snap/bin/ghostty --title=btop -e btop ;;

  terminal)    launch /snap/bin/ghostty ;;   # new window; absolute snap path, Companion's shell has no user PATH

  fullscreen)  ydotool key 29:1 125:1 33:1 33:0 125:0 29:0 ;;   # Ctrl+Super+F (bind to GNOME toggle-fullscreen, see tutorial)

  cursor)      focus activateByWmClass "Cursor" || launch cursor ;;   # adjust 'cursor' to your AppImage path if needed

  screenshot)  ydotool key 99:1 99:0 ;;   # Print key -> GNOME screenshot UI (region select is the default mode)

  lazygit)     launch /snap/bin/ghostty --title=lazygit \
                 --working-directory="$HOME" -e lazygit ;;   # change --working-directory to your main repo

  claude-code) focus activateBySubstring "claude" || \
                 launch /snap/bin/ghostty --title="Claude Code" -e bash -ic claude ;;

  voice)       pkill -USR2 -x handy ;;   # toggle Handy recording (SIGUSR2); use -USR1 for post-processed mode

  accept)      ydotool key 28:1 28:0 ;;   # press Enter in whatever window is focused

  # ================= PAGE 2 — desktop & media =================
  ws-left)     ydotool key 125:1 104:1 104:0 125:0 ;;   # Super+PageUp  = GNOME workspace to the left
  ws-right)    ydotool key 125:1 109:1 109:0 125:0 ;;   # Super+PageDown = GNOME workspace to the right

  claude)      focus activateByWmClass "Claude" || launch claude-desktop ;;   # adjust launch cmd to your install

  pause)       playerctl -p spotify play-pause ;;
  next)        playerctl -p spotify next ;;

  spotify)     focus activateByWmClass "Spotify" || launch spotify ;;
               # flatpak: replace 'spotify' with: flatpak run com.spotify.Client

  vivaldi)     focus activateBySubstring "Vivaldi" || launch vivaldi ;;
  
  vivaldi-ws)  { focus activateBySubstring "Vivaldi" || launch vivaldi; }
                sleep 0.25
                ydotool key 29:1 52:1 52:0 29:0 ;;   # Ctrl+.  -> bind to "Next Workspace" in Vivaldi (cycles)

  youtube)     launch vivaldi https://www.youtube.com ;;   # opens as a tab in the running Vivaldi

  *) echo "unknown action: ${1:-}" >&2; exit 1 ;;
esac
